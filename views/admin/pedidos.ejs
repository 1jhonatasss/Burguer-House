<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos Finalizados - Admin</title>
    <link rel="stylesheet" href="/css/admin-mobile.css">
    <link rel="stylesheet" href="/css/cardapio.css">
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <style>
        :root {
            --primary-red: #dc2626;
            --primary-orange: #ea580c;
            --primary-yellow: #f59e0b;
            --gray-900: #111827;
            --gray-800: #1f2937;
            --gray-700: #374151;
            --gray-600: #4b5563;
            --gray-500: #6b7280;
            --gray-400: #9ca3af;
            --gray-300: #d1d5db;
            --gray-200: #e5e7eb;
            --gray-100: #f3f4f6;
            --white: #ffffff;
        }

        .admin-container {
            display: flex;
            min-height: 100vh;
            background: var(--gray-900);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        .admin-sidebar {
            width: 280px;
            background: var(--gray-800);
            border-right: 1px solid var(--gray-700);
            padding: 2rem 1.5rem;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
        }

        .admin-logo {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 3rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--gray-700);
        }

        .admin-logo h1 {
            font-size: 1.5rem;
            background: linear-gradient(135deg, var(--primary-yellow), var(--primary-orange));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 900;
        }

        .admin-nav {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            border-radius: 0.75rem;
            color: var(--gray-300);
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 600;
        }

        .admin-nav-link:hover,
        .admin-nav-link.active {
            background: linear-gradient(135deg, var(--primary-red), var(--primary-orange));
            color: white;
        }

        .admin-main {
            flex: 1;
            padding: 2rem;
            margin-left: 280px;
            overflow-y: auto;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--gray-700);
        }

        .admin-header h1 {
            font-size: 1.75rem;
            font-weight: 700;
            color: white;
        }

        .admin-section {
            background: var(--gray-800);
            border-radius: 1rem;
            padding: 1.5rem;
            margin-bottom: 2rem;
            border: 1px solid var(--gray-700);
        }

        .table-container {
            overflow-x: auto;
            border-radius: 0.5rem;
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--gray-800);
        }

        .admin-table th,
        .admin-table td {
            padding: 1rem;
            text-align: left;
            border-bottom: 1px solid var(--gray-700);
        }

        .admin-table th {
            color: var(--gray-400);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
            background: var(--gray-700);
        }

        .admin-table td {
            color: var(--gray-300);
        }

        .admin-table tr:hover {
            background: var(--gray-750);
        }

        .status-badge {
            padding: 0.375rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            display: inline-block;
        }

        .status-entregue {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
            border: 1px solid #10b981;
        }

        .status-pronto {
            background: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
            border: 1px solid #3b82f6;
        }

        .btn-action {
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 0.5rem;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-delete {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 1px solid #ef4444;
        }

        .btn-delete:hover {
            background: #ef4444;
            color: white;
        }

        .notificacao {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 1rem 1.5rem;
            border-radius: 0.75rem;
            color: white;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }

        .notificacao.sucesso {
            background: linear-gradient(135deg, #10b981, #047857);
            border: 1px solid #10b981;
        }

        .notificacao.erro {
            background: linear-gradient(135deg, #ef4444, #b91c1c);
            border: 1px solid #ef4444;
        }

        .filter-info {
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid #3b82f6;
            color: #3b82f6;
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1.5rem;
            font-size: 0.875rem;
        }

        /* Estilos para os itens do pedido */
        .itens-pedido {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            max-width: 400px;
        }

        .item-pedido {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.75rem;
            background: var(--gray-700);
            border-radius: 0.5rem;
            font-size: 0.875rem;
        }

        .item-pedido .item-emoji {
            font-size: 1.1rem;
        }

        .item-pedido .item-nome {
            flex: 1;
            color: var(--gray-200);
            font-weight: 500;
        }

        .item-pedido .item-qtd {
            background: var(--primary-orange);
            color: white;
            padding: 0.125rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .item-pedido .item-preco {
            color: var(--primary-yellow);
            font-weight: 600;
        }

        .item-adicionais {
            font-size: 0.7rem;
            color: var(--gray-400);
            margin-top: 0.25rem;
            padding-left: 1.5rem;
        }

        .item-removidos {
            font-size: 0.7rem;
            color: #ef4444;
            margin-top: 0.125rem;
            padding-left: 1.5rem;
        }

        @media (max-width: 768px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }
            
            .admin-main {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <div class="admin-sidebar">
            <div class="admin-logo">
                <i data-lucide="shield"></i>
                <h1>Admin Burger</h1>
            </div>

            <nav class="admin-nav">
                <a href="/admin" class="admin-nav-link">
                    <i data-lucide="layout-dashboard"></i>
                    Dashboard
                </a>
                <a href="/admin/pedidos" class="admin-nav-link active">
                    <i data-lucide="clipboard-list"></i>
                    Pedidos Finalizados
                </a>
                <a href="/admin/produtos" class="admin-nav-link">
                    <i data-lucide="package"></i>
                    Produtos
                </a>
                <a href="/admin/banners" class="admin-nav-link">
                    <i data-lucide="image"></i>
                    Banners
                </a>
                <a href="/cardapio" class="admin-nav-link">
                    <i data-lucide="store"></i>
                    Voltar ao Cardápio
                </a>
            </nav>
        </div>

        <div class="admin-main">
            <div class="admin-header">
                <h1>Pedidos Finalizados</h1>
            </div>

            <div class="filter-info">
                Mostrando apenas pedidos com status "entregue" e "pronto"
            </div>
            
            <div id="notificacao" class="notificacao" style="display: none;"></div>

            <div class="admin-section">
                <div class="table-container">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Nº Pedido</th>
                                <th>Itens</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Data</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody id="tabela-pedidos">
                            <% 
                            // Filtrar apenas pedidos finalizados (entregue e pronto)
                            const pedidosFinalizados = pedidos ? pedidos.filter(p => 
                                p.pedidoStatus === 'entregue' || p.pedidoStatus === 'pronto'
                            ) : [];

                            // Função para fazer parse dos itens
                            function parseItens(itensStr) {
                                try {
                                    if (typeof itensStr === 'string') {
                                        return JSON.parse(itensStr);
                                    }
                                    return itensStr || [];
                                } catch (e) {
                                    return [];
                                }
                            }

                            // Função para formatar preço
                            function formatarPreco(valor) {
                                return parseFloat(valor || 0).toFixed(2).replace('.', ',');
                            }
                            %>
                            <% if (pedidosFinalizados.length > 0) { %>
                                <% pedidosFinalizados.forEach(pedido => { %>
                                    <%
                                    const pedidoId = pedido.pedidoId || 0;
                                    const pedidoNumero = pedido.pedidoNumero || 'N/A';
                                    const pedidoItensRaw = pedido.pedidoItens || '[]';
                                    const pedidoItens = parseItens(pedidoItensRaw);
                                    const pedidoTotal = pedido.pedidoTotal || 0;
                                    const pedidoStatus = pedido.pedidoStatus || 'entregue';
                                    const pedidoData = pedido.pedidoDataCriacao || new Date();
                                    %>
                                    <tr id="pedido-<%= pedidoId %>">
                                        <td><strong>#<%= pedidoNumero %></strong></td>
                                        <td>
                                            <div class="itens-pedido">
                                                <% if (Array.isArray(pedidoItens) && pedidoItens.length > 0) { %>
                                                    <% pedidoItens.forEach(item => { %>
                                                        <div class="item-pedido">
                                                            <span class="item-emoji">🍔</span>
                                                            <span class="item-nome"><%= item.nome || 'Produto' %></span>
                                                            <span class="item-qtd"><%= item.quantidade || 1 %>x</span>
                                                            <span class="item-preco">R$ <%= formatarPreco(item.subtotal || item.precoUnitario) %></span>
                                                        </div>
                                                        <% if (item.adicionais && item.adicionais.length > 0) { %>
                                                            <div class="item-adicionais">
                                                                + <%= item.adicionais.map(a => a.nome || a).join(', ') %>
                                                            </div>
                                                        <% } %>
                                                        <% if (item.removidos && item.removidos.length > 0) { %>
                                                            <div class="item-removidos">
                                                                − <%= item.removidos.map(r => r.nome || r).join(', ') %>
                                                            </div>
                                                        <% } %>
                                                    <% }) %>
                                                <% } else { %>
                                                    <span style="color: var(--gray-500);">Sem itens</span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td><strong style="color: var(--primary-yellow);">R$ <%= formatarPreco(pedidoTotal) %></strong></td>
                                        <td>
                                            <span class="status-badge status-<%= pedidoStatus %>">
                                                <%= pedidoStatus.charAt(0).toUpperCase() + pedidoStatus.slice(1) %>
                                            </span>
                                        </td>
                                        <td>
                                            <% 
                                            try {
                                                const data = new Date(pedidoData);
                                                if (!isNaN(data.getTime())) {
                                            %>
                                                <%= data.toLocaleDateString('pt-BR') %><br>
                                                <small style="color: var(--gray-500);"><%= data.toLocaleTimeString('pt-BR').slice(0, 5) %></small>
                                            <% 
                                                } else { 
                                            %>
                                                Data inválida
                                            <% 
                                                }
                                            } catch (e) { 
                                            %>
                                                Erro na data
                                            <% 
                                            } 
                                            %>
                                        </td>
                                        <td>
                                            <button class="btn-action btn-delete" onclick="excluirPedido(<%= pedidoId %>, '<%= pedidoNumero %>')">
                                                <i data-lucide="trash-2"></i>
                                                Excluir
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" style="text-align: center; color: var(--gray-500); padding: 3rem;">
                                        <i data-lucide="package"></i>
                                        <p>Nenhum pedido finalizado encontrado</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });

        function mostrarNotificacao(mensagem, tipo = 'sucesso') {
            const notificacao = document.getElementById('notificacao');
            const texto = notificacao.querySelector('span') || document.createElement('span');
            texto.textContent = mensagem;
            
            if (!notificacao.contains(texto)) {
                notificacao.appendChild(texto);
            }
            
            notificacao.className = `notificacao ${tipo}`;
            notificacao.style.display = 'flex';
            
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
            
            setTimeout(() => {
                notificacao.style.display = 'none';
            }, 3000);
        }
        
        async function excluirPedido(pedidoId, numeroPedido) {
            try {
                if (!confirm(`Tem certeza que deseja excluir o pedido finalizado #${numeroPedido}? Esta ação não pode ser desfeita.`)) {
                    return;
                }

                const idNumerico = Number(pedidoId);
                const response = await fetch(`/admin/pedidos/excluir/${idNumerico}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                
                const resultado = await response.json();
                
                if (resultado.ok) {
                    mostrarNotificacao('Pedido excluído com sucesso!', 'sucesso');
                    
                    const linha = document.getElementById(`pedido-${pedidoId}`);
                    if (linha) linha.remove();
                    
                    const tbody = document.getElementById('tabela-pedidos');
                    const linhasComDados = Array.from(tbody.querySelectorAll('tr[id]')).filter(tr => 
                        tr.id && tr.id.startsWith('pedido-')
                    );
                    
                    if (linhasComDados.length === 0) {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="6" style="text-align: center; color: var(--gray-500); padding: 3rem;">
                                    <i data-lucide="package"></i>
                                    <p>Nenhum pedido finalizado encontrado</p>
                                </td>
                            </tr>
                        `;
                    }
                } else {
                    mostrarNotificacao('Erro ao excluir pedido: ' + resultado.msg, 'erro');
                }
            } catch (error) {
                console.error('Erro completo na exclusão:', error);
                mostrarNotificacao('Erro de conexão ao excluir pedido', 'erro');
            }
        }
    </script>
    <script src="/js/admin-mobile.js"></script>
</body>
</html>
