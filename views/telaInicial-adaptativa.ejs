    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

body {
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
    overflow-x: hidden;
    overflow-y: auto;
    min-height: 100vh;
    background: #050505;
}

@media (min-width: 769px) {
    body {
        overflow: hidden;
        height: 100vh;
    }
}

        /* ============================================
           VERSÃO MOBILE - Simples e Animada
           ============================================ */
        .mobile-version {
            display: none;
        }

@media (max-width: 768px) {
    .mobile-version .particles{
        display: none;
    }
    .desktop-version {
        display: none;
    }
    
    /* Compacta tudo para caber em iPhone 11 e menores */
.mobile-version .container {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background: #0a0a0a;
    padding-top: calc(1.5rem + env(safe-area-inset-top));
    padding-bottom: calc(1.5rem + env(safe-area-inset-bottom));
    padding-left: 1rem;
    padding-right: 1rem;
}
    
    /* Em telas BAIXAS (menos de 750px de altura), encolhe mais */
    @media (max-height: 750px) {
        .mobile-version .container {
            padding-top: calc(1rem + env(safe-area-inset-top));
            padding-bottom: calc(1rem + env(safe-area-inset-bottom));
            justify-content: flex-start;
        }
    }
    
    .mobile-version .badge {
        margin-bottom: 0.75rem;
        padding: 0.35rem 0.85rem;
    }
    
    .mobile-version .badge span {
        font-size: 0.7rem;
    }
    
    .mobile-version .logo {
        margin-bottom: 0.5rem;
    }
    
    .mobile-version .logo-icon {
        font-size: 2.5rem;
        margin-bottom: 0.25rem;
    }
    
    .mobile-version .logo h1 {
        font-size: 2.5rem;
    }
    
    .mobile-version .logo h2 {
        font-size: 1.1rem;
        letter-spacing: 0.35em;
        margin-top: 0.25rem;
    }
    
    .mobile-version .description {
        font-size: 0.85rem;
        line-height: 1.5;
        margin-bottom: 1.25rem;
        padding: 0 0.25rem;
    }
    
    .mobile-version .cta-wrapper {
        margin-bottom: 1.25rem;
    }
    
    .mobile-version .cta-button {
        padding: 0.85rem 1.75rem;
        font-size: 0.9rem;
    }
    
    .mobile-version .cta-button i {
        width: 16px;
        height: 16px;
    }
    
    .mobile-version .features {
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
    }
    
    .mobile-version .feature {
        font-size: 0.7rem;
    }
    
    .mobile-version .feature i {
        width: 13px;
        height: 13px;
    }
}

        .mobile-version .container {
            position: relative;
            width: 100%;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            overflow-x: hidden;
            background: #0a0a0a;
            padding-top: calc(2rem + env(safe-area-inset-top));
            padding-bottom: calc(2rem + env(safe-area-inset-bottom));
            padding-left: 1rem;
            padding-right: 1rem;
        }

        @media (min-height: 750px) {
            .mobile-version .container {
                justify-content: center;
            }
        }

        /* Background animado mobile */
        .mobile-version .bg-gradient {
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(ellipse at 20% 0%, rgba(234, 88, 12, 0.15) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 100%, rgba(220, 38, 38, 0.1) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 50%, rgba(251, 191, 36, 0.05) 0%, transparent 70%);
            animation: pulseGlow 8s ease-in-out infinite;
            pointer-events: none;
        }

        @keyframes pulseGlow {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        /* Partículas flutuantes mobile */
        .mobile-version .particles {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .mobile-version .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: rgba(251, 191, 36, 0.3);
            border-radius: 50%;
            animation: float 20s infinite;
        }

        .mobile-version .particle:nth-child(1) { left: 10%; animation-delay: 0s; animation-duration: 25s; }
        .mobile-version .particle:nth-child(2) { left: 20%; animation-delay: 2s; animation-duration: 20s; }
        .mobile-version .particle:nth-child(3) { left: 30%; animation-delay: 4s; animation-duration: 28s; }
        .mobile-version .particle:nth-child(4) { left: 40%; animation-delay: 1s; animation-duration: 22s; }
        .mobile-version .particle:nth-child(5) { left: 50%; animation-delay: 3s; animation-duration: 24s; }
        .mobile-version .particle:nth-child(6) { left: 60%; animation-delay: 5s; animation-duration: 26s; }
        .mobile-version .particle:nth-child(7) { left: 70%; animation-delay: 2s; animation-duration: 21s; }
        .mobile-version .particle:nth-child(8) { left: 80%; animation-delay: 4s; animation-duration: 23s; }
        .mobile-version .particle:nth-child(9) { left: 90%; animation-delay: 1s; animation-duration: 27s; }

        @keyframes float {
            0% { transform: translateY(100vh) scale(0); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-100vh) scale(1); opacity: 0; }
        }

        .mobile-version .content {
            position: relative;
            z-index: 10;
            text-align: center;
            max-width: 700px;
            width: 100%;
            padding: 0;
        }

        .mobile-version .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(251, 191, 36, 0.1);
            border: 1px solid rgba(251, 191, 36, 0.3);
            padding: 0.4rem 1rem;
            border-radius: 50px;
            margin-bottom: 1.25rem;
            animation: fadeInDown 0.8s ease;
        }

        .mobile-version .badge-dot {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.2); opacity: 0.7; }
        }

        .mobile-version .badge span {
            color: #fbbf24;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .mobile-version .logo {
            margin-bottom: 0.75rem;
            animation: fadeInUp 0.8s ease 0.2s backwards;
        }

        .mobile-version .logo-icon {
            font-size: 3rem;
            margin-bottom: 0.5rem;
            display: block;
            animation: bounce 3s ease-in-out infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-15px); }
        }

        .mobile-version .logo h1 {
            font-size: 2.5rem;
            font-weight: 900;
            letter-spacing: -0.03em;
            line-height: 1;
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 30%, #ea580c 60%, #dc2626 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .mobile-version .logo h2 {
            font-size: 1.25rem;
            font-weight: 300;
            color: #ffffff;
            letter-spacing: 0.4em;
            margin-top: 0.35rem;
            opacity: 0.9;
        }

        .mobile-version .description {
            color: #9ca3af;
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
            animation: fadeInUp 0.8s ease 0.4s backwards;
            padding: 0 0.5rem;
        }

        .mobile-version .description strong {
            color: #f59e0b;
        }

        .mobile-version .cta-wrapper {
            animation: fadeInUp 0.8s ease 0.6s backwards;
            margin-bottom: 1.5rem;
        }

        .mobile-version .cta-button {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            background: linear-gradient(135deg, #ea580c 0%, #dc2626 100%);
            color: white;
            padding: 0.9rem 2rem;
            border-radius: 100px;
            font-size: 0.95rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 40px rgba(220, 38, 38, 0.4);
        }

        .mobile-version .cta-button:active {
            transform: translateY(-2px) scale(0.98);
        }

        .mobile-version .cta-button i {
            width: 18px;
            height: 18px;
        }

        .mobile-version .features {
            display: flex;
            justify-content: center;
            gap: 1.25rem;
            margin-top: 0;
            animation: fadeInUp 0.8s ease 0.8s backwards;
            flex-wrap: wrap;
            padding: 0 0.5rem;
        }

        .mobile-version .feature {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            color: #6b7280;
            font-size: 0.75rem;
        }

        .mobile-version .feature i {
            width: 14px;
            height: 14px;
            color: #f59e0b;
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Mobile extra pequeno */
        @media (max-width: 480px) {
            .mobile-version .logo h1 { font-size: 2.25rem; }
            .mobile-version .logo h2 { font-size: 1.1rem; letter-spacing: 0.3em; }
            .mobile-version .logo-icon { font-size: 2.75rem; }
            .mobile-version .badge { padding: 0.35rem 0.85rem; margin-bottom: 1rem; }
            .mobile-version .badge span { font-size: 0.7rem; }
            .mobile-version .description { font-size: 0.85rem; margin-bottom: 1.25rem; }
            .mobile-version .cta-button { padding: 0.85rem 1.75rem; font-size: 0.9rem; }
            .mobile-version .cta-wrapper { margin-bottom: 1.25rem; }
            .mobile-version .features { flex-direction: column; gap: 0.75rem; }
            .mobile-version .feature { justify-content: center; font-size: 0.8rem; }
        }

        @media (max-width: 360px) {
            .mobile-version .logo h1 { font-size: 2rem; }
            .mobile-version .logo h2 { font-size: 1rem; letter-spacing: 0.25em; }
            .mobile-version .logo-icon { font-size: 2.5rem; }
            .mobile-version .description { font-size: 0.8rem; }
            .mobile-version .cta-button { padding: 0.8rem 1.5rem; font-size: 0.85rem; }
        }

        /* ============================================
           VERSÃO DESKTOP - Robusta Original
           ============================================ */
        .desktop-version {
            display: block;
        }

        .desktop-version .container {
            position: relative;
            width: 100%;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .desktop-version .bg-grid {
            position: absolute;
            inset: 0;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%);
            -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%);
        }

        .desktop-version .bg-gradient {
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(ellipse 80% 50% at 50% -20%, rgba(234, 88, 12, 0.15) 0%, transparent 50%),
                radial-gradient(ellipse 60% 40% at 100% 100%, rgba(220, 38, 38, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse 60% 40% at 0% 100%, rgba(251, 191, 36, 0.06) 0%, transparent 50%);
            animation: pulseGlowDesktop 10s ease-in-out infinite;
        }

        @keyframes pulseGlowDesktop {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.05); }
        }

        .desktop-version .bg-circles {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .desktop-version .circle {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(251, 191, 36, 0.1);
            animation: rotateCircle 30s linear infinite;
        }

        .desktop-version .circle-1 {
            width: 600px;
            height: 600px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .desktop-version .circle-2 {
            width: 800px;
            height: 800px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-direction: reverse;
            animation-duration: 40s;
            border-color: rgba(234, 88, 12, 0.08);
        }

        .desktop-version .circle-3 {
            width: 1000px;
            height: 1000px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-duration: 50s;
            border-color: rgba(220, 38, 38, 0.05);
        }

        @keyframes rotateCircle {
            from { transform: translate(-50%, -50%) rotate(0deg); }
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }

        .desktop-version .particles {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .desktop-version .particle {
            position: absolute;
            background: rgba(251, 191, 36, 0.4);
            border-radius: 50%;
            animation: floatParticle 20s infinite;
            filter: blur(1px);
        }

        .desktop-version .particle:nth-child(1) { left: 10%; width: 3px; height: 3px; animation-delay: 0s; animation-duration: 25s; }
        .desktop-version .particle:nth-child(2) { left: 20%; width: 4px; height: 4px; animation-delay: 2s; animation-duration: 20s; }
        .desktop-version .particle:nth-child(3) { left: 30%; width: 2px; height: 2px; animation-delay: 4s; animation-duration: 28s; }
        .desktop-version .particle:nth-child(4) { left: 40%; width: 3px; height: 3px; animation-delay: 1s; animation-duration: 22s; }
        .desktop-version .particle:nth-child(5) { left: 50%; width: 5px; height: 5px; animation-delay: 3s; animation-duration: 24s; }
        .desktop-version .particle:nth-child(6) { left: 60%; width: 2px; height: 2px; animation-delay: 5s; animation-duration: 26s; }
        .desktop-version .particle:nth-child(7) { left: 70%; width: 4px; height: 4px; animation-delay: 2s; animation-duration: 21s; }
        .desktop-version .particle:nth-child(8) { left: 80%; width: 3px; height: 3px; animation-delay: 4s; animation-duration: 23s; }
        .desktop-version .particle:nth-child(9) { left: 90%; width: 2px; height: 2px; animation-delay: 1s; animation-duration: 27s; }

        @keyframes floatParticle {
            0% { transform: translateY(100vh) scale(0); opacity: 0; }
            10% { opacity: 0.8; }
            90% { opacity: 0.8; }
            100% { transform: translateY(-100vh) scale(1); opacity: 0; }
        }

        .desktop-version .content {
            position: relative;
            z-index: 10;
            text-align: center;
            padding: 2rem;
            max-width: 700px;
        }

        .desktop-version .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            padding: 0.6rem 1.5rem;
            border-radius: 50px;
            margin-bottom: 2.5rem;
            animation: fadeInDownDesktop 0.8s ease;
            backdrop-filter: blur(10px);
        }

        .desktop-version .badge-dot {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
            animation: pulseDesktop 2s infinite;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
        }

        @keyframes pulseDesktop {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.7; }
        }

        .desktop-version .badge span {
            color: #10b981;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.1em;
        }

        .desktop-version .logo {
            margin-bottom: 2rem;
            animation: fadeInUpDesktop 0.8s ease 0.2s backwards;
        }

        .desktop-version .logo-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
            display: block;
            animation: floatIcon 4s ease-in-out infinite;
            filter: drop-shadow(0 10px 30px rgba(251, 191, 36, 0.3));
        }

        @keyframes floatIcon {
            0%, 100% { transform: translateY(0) rotate(-5deg); }
            50% { transform: translateY(-12px) rotate(5deg); }
        }

        .desktop-version .logo h1 {
            font-size: 5rem;
            font-weight: 900;
            letter-spacing: -0.02em;
            line-height: 0.9;
            background: linear-gradient(135deg, #fff 0%, #fbbf24 50%, #ea580c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            position: relative;
        }

        .desktop-version .logo h1::after {
            content: 'BURGER';
            position: absolute;
            left: 0;
            top: 0;
            background: linear-gradient(135deg, #fbbf24 0%, #ea580c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: blur(30px);
            opacity: 0.5;
            z-index: -1;
        }

        .desktop-version .logo h2 {
            font-size: 2.5rem;
            font-weight: 200;
            color: #ffffff;
            letter-spacing: 0.5em;
            margin-top: 0.25rem;
            opacity: 0.9;
        }

        .desktop-version .divider {
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, transparent, #ea580c, transparent);
            margin: 1.5rem auto;
            border-radius: 2px;
            animation: fadeInUpDesktop 0.8s ease 0.3s backwards;
        }

        .desktop-version .description {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.15rem;
            line-height: 1.8;
            margin-bottom: 2.5rem;
            font-weight: 400;
            animation: fadeInUpDesktop 0.8s ease 0.4s backwards;
        }

        .desktop-version .description strong {
            color: #fbbf24;
            font-weight: 600;
        }

        .desktop-version .cta-wrapper {
            animation: fadeInUpDesktop 0.8s ease 0.6s backwards;
        }

        .desktop-version .cta-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            background: linear-gradient(135deg, #fbbf24, #ea580c);
            color: #000;
            padding: 1.25rem 3rem;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 10px 40px rgba(251, 191, 36, 0.3);
            position: relative;
            overflow: hidden;
        }

        .desktop-version .cta-button::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .desktop-version .cta-button:hover::before {
            opacity: 1;
        }

        .desktop-version .cta-button:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 50px rgba(251, 191, 36, 0.4);
        }

        .desktop-version .cta-button i {
            width: 22px;
            height: 22px;
            transition: transform 0.3s;
        }

        .desktop-version .cta-button:hover i {
            transform: translateX(5px);
        }

        .desktop-version .features {
            display: flex;
            justify-content: center;
            gap: 3rem;
            margin-top: 4rem;
            animation: fadeInUpDesktop 0.8s ease 0.8s backwards;
        }

        .desktop-version .feature {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
        }

        .desktop-version .feature-icon {
            width: 44px;
            height: 44px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.25rem;
            transition: all 0.3s ease;
        }

        .desktop-version .feature:hover .feature-icon {
            background: rgba(251, 191, 36, 0.1);
            border-color: rgba(251, 191, 36, 0.3);
            transform: translateY(-4px);
        }

        .desktop-version .feature-icon i {
            width: 20px;
            height: 20px;
            color: #fbbf24;
        }

        .desktop-version .feature span {
            color: #71717a;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .desktop-version .scroll-indicator {
            position: absolute;
            bottom: 2.5rem;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
            animation: fadeInDesktop 1s ease 1.2s backwards;
        }

        .desktop-version .scroll-mouse {
            width: 26px;
            height: 42px;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 14px;
            position: relative;
            transition: border-color 0.3s;
        }

        .desktop-version .scroll-indicator:hover .scroll-mouse {
            border-color: rgba(251, 191, 36, 0.5);
        }

        .desktop-version .scroll-wheel {
            width: 3px;
            height: 8px;
            background: linear-gradient(180deg, #fbbf24, #ea580c);
            border-radius: 2px;
            position: absolute;
            top: 8px;
            left: 50%;
            transform: translateX(-50%);
            animation: scrollWheelDesktop 2s infinite;
        }

        @keyframes scrollWheelDesktop {
            0% { opacity: 1; transform: translateX(-50%) translateY(0); }
            100% { opacity: 0; transform: translateX(-50%) translateY(12px); }
        }

        .desktop-version .scroll-text {
            color: #52525b;
