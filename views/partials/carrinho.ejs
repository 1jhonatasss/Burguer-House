<div class="carrinho-dock-container">
    <div class="carrinho-dock collapsed" id="carrinhoDock">
        <div class="carrinho-dock-header" onclick="toggleDock()">
            <div class="carrinho-dock-info">
                <div class="carrinho-dock-icon">
                    <i data-lucide="shopping-cart"></i>
                    <span class="carrinho-dock-badge" id="carrinhoBadge" style="display: none;">0</span>
                </div>
                <div class="carrinho-dock-text">
                    <h3 class="carrinho-dock-titulo">Seu Pedido</h3>
                    <p class="carrinho-dock-subtitulo" id="carrinhoSubtitulo">Carrinho vazio</p>
                </div>
            </div>
            <div class="carrinho-dock-actions">
                <div id="carrinhoActionsContent" style="display: none;">
                    <div class="carrinho-dock-total">
                        <span class="carrinho-dock-total-label">Total</span>
                        <span class="carrinho-dock-total-valor" id="carrinhoTotalValor">R$ 0,00</span>
                    </div>
                    <button class="btn-finalizar-dock" onclick="event.stopPropagation(); finalizarPedido();">
                        <i data-lucide="check"></i> Finalizar
                    </button>
                </div>
                <div class="carrinho-dock-toggle"><i data-lucide="chevron-up"></i></div>
            </div>
        </div>
        <div class="carrinho-dock-content" id="carrinhoDockContent">
            <div class="carrinho-dock-vazio" id="carrinhoVazio">
                <i data-lucide="shopping-cart"></i>
                <p>Seu carrinho está vazio</p>
            </div>
        </div>
    </div>
</div>

<script>
function toggleDock() {
    const dock = document.getElementById('carrinhoDock');
    dock.classList.toggle('collapsed');
    dock.classList.toggle('expanded');
    setTimeout(() => lucide?.createIcons(), 100);
}
document.addEventListener('DOMContentLoaded', () => {
    if (typeof atualizarUICarrinho === 'function') atualizarUICarrinho();
});
</script>