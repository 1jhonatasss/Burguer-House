<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Burger House - Os Melhores Hamburgueres</title>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
            overflow: hidden;
            height: 100vh;
            background: #050505;
        }

        .container {
            position: relative;
            width: 100%;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Background com grid sutil */
        .bg-grid {
            position: absolute;
            inset: 0;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%);
            -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%);
        }

        /* Background gradiente animado */
        .bg-gradient {
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(ellipse 80% 50% at 50% -20%, rgba(234, 88, 12, 0.15) 0%, transparent 50%),
                radial-gradient(ellipse 60% 40% at 100% 100%, rgba(220, 38, 38, 0.08) 0%, transparent 50%),
                radial-gradient(ellipse 60% 40% at 0% 100%, rgba(251, 191, 36, 0.06) 0%, transparent 50%);
            animation: pulseGlow 10s ease-in-out infinite;
        }

        @keyframes pulseGlow {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.05); }
        }

        /* Círculos decorativos */
        .bg-circles {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .circle {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(251, 191, 36, 0.1);
            animation: rotateCircle 30s linear infinite;
        }

        .circle-1 {
            width: 600px;
            height: 600px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .circle-2 {
            width: 800px;
            height: 800px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-direction: reverse;
            animation-duration: 40s;
            border-color: rgba(234, 88, 12, 0.08);
        }

        .circle-3 {
            width: 1000px;
            height: 1000px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-duration: 50s;
            border-color: rgba(220, 38, 38, 0.05);
        }

        @keyframes rotateCircle {
            from { transform: translate(-50%, -50%) rotate(0deg); }
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }

        /* Partículas flutuantes melhoradas */
        .particles {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .particle {
            position: absolute;
            background: rgba(251, 191, 36, 0.4);
            border-radius: 50%;
            animation: floatParticle 20s infinite;
            filter: blur(1px);
        }

        .particle:nth-child(1) { left: 10%; width: 3px; height: 3px; animation-delay: 0s; animation-duration: 25s; }
        .particle:nth-child(2) { left: 20%; width: 4px; height: 4px; animation-delay: 2s; animation-duration: 20s; }
        .particle:nth-child(3) { left: 30%; width: 2px; height: 2px; animation-delay: 4s; animation-duration: 28s; }
        .particle:nth-child(4) { left: 40%; width: 3px; height: 3px; animation-delay: 1s; animation-duration: 22s; }
        .particle:nth-child(5) { left: 50%; width: 5px; height: 5px; animation-delay: 3s; animation-duration: 24s; }
        .particle:nth-child(6) { left: 60%; width: 2px; height: 2px; animation-delay: 5s; animation-duration: 26s; }
        .particle:nth-child(7) { left: 70%; width: 4px; height: 4px; animation-delay: 2s; animation-duration: 21s; }
        .particle:nth-child(8) { left: 80%; width: 3px; height: 3px; animation-delay: 4s; animation-duration: 23s; }
        .particle:nth-child(9) { left: 90%; width: 2px; height: 2px; animation-delay: 1s; animation-duration: 27s; }

        @keyframes floatParticle {
            0% { transform: translateY(100vh) scale(0); opacity: 0; }
            10% { opacity: 0.8; }
            90% { opacity: 0.8; }
            100% { transform: translateY(-100vh) scale(1); opacity: 0; }
        }

        /* Conteúdo principal */
        .content {
            position: relative;
            z-index: 10;
            text-align: center;
            padding: 2rem;
            max-width: 700px;
        }

        /* Badge superior */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            padding: 0.6rem 1.5rem;
            border-radius: 50px;
            margin-bottom: 2.5rem;
            animation: fadeInDown 0.8s ease;
            backdrop-filter: blur(10px);
        }

        .badge-dot {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
            animation: pulse 2s infinite;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.7; }
        }

        .badge span {
            color: #10b981;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.1em;
        }

        /* Logo animado */
        .logo {
            margin-bottom: 2rem;
            animation: fadeInUp 0.8s ease 0.2s backwards;
        }

        .logo-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
            display: block;
            animation: floatIcon 4s ease-in-out infinite;
            filter: drop-shadow(0 10px 30px rgba(251, 191, 36, 0.3));
        }

        @keyframes floatIcon {
            0%, 100% { transform: translateY(0) rotate(-5deg); }
            50% { transform: translateY(-12px) rotate(5deg); }
        }

        .logo h1 {
            font-size: 5rem;
            font-weight: 900;
            letter-spacing: -0.02em;
            line-height: 0.9;
            background: linear-gradient(135deg, #fff 0%, #fbbf24 50%, #ea580c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            position: relative;
        }

        .logo h1::after {
            content: 'BURGER';
            position: absolute;
            left: 0;
            top: 0;
            background: linear-gradient(135deg, #fbbf24 0%, #ea580c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: blur(30px);
            opacity: 0.5;
            z-index: -1;
        }

        .logo h2 {
            font-size: 2.5rem;
            font-weight: 200;
            color: #ffffff;
            letter-spacing: 0.5em;
            margin-top: 0.25rem;
            opacity: 0.9;
        }

        /* Linha decorativa */
        .divider {
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, transparent, #ea580c, transparent);
            margin: 1.5rem auto;
            border-radius: 2px;
            animation: fadeInUp 0.8s ease 0.3s backwards;
        }

        /* Descrição */
        .description {
            color: #a1a1aa;
            font-size: 1.1rem;
            line-height: 1.8;
            margin-bottom: 3rem;
            animation: fadeInUp 0.8s ease 0.4s backwards;
            font-weight: 300;
        }

        .description strong {
            color: #fbbf24;
            font-weight: 600;
        }

        /* Botão CTA */
        .cta-wrapper {
            animation: fadeInUp 0.8s ease 0.6s backwards;
        }

        .cta-button {
            display: inline-flex;
            align-items: center;
            gap: 1rem;
            background: linear-gradient(135deg, #ea580c 0%, #dc2626 100%);
            color: white;
            padding: 1.25rem 3.5rem;
            border-radius: 100px;
            font-size: 1.1rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 
                0 10px 40px rgba(220, 38, 38, 0.3),
                0 0 0 0 rgba(234, 88, 12, 0.4);
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .cta-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.6s;
        }

        .cta-button:hover::before {
            left: 100%;
        }

        .cta-button:hover {
            transform: translateY(-4px);
            box-shadow: 
                0 20px 50px rgba(220, 38, 38, 0.4),
                0 0 0 4px rgba(234, 88, 12, 0.2);
        }

        .cta-button:active {
            transform: translateY(-2px) scale(0.98);
        }

        .cta-button i {
            width: 22px;
            height: 22px;
            transition: transform 0.3s;
        }

        .cta-button:hover i {
            transform: translateX(6px);
        }

        /* Indicadores inferiores */
        .features {
            display: flex;
            justify-content: center;
            gap: 3rem;
            margin-top: 4rem;
            animation: fadeInUp 0.8s ease 0.8s backwards;
        }

        .feature {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
        }

        .feature-icon {
            width: 44px;
            height: 44px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.25rem;
            transition: all 0.3s ease;
        }

        .feature:hover .feature-icon {
            background: rgba(251, 191, 36, 0.1);
            border-color: rgba(251, 191, 36, 0.3);
            transform: translateY(-4px);
        }

        .feature-icon i {
            width: 20px;
            height: 20px;
            color: #fbbf24;
        }

        .feature span {
            color: #71717a;
            font-size: 0.8rem;
            font-weight: 500;
        }

        /* Scroll indicator */
        .scroll-indicator {
            position: absolute;
            bottom: 2.5rem;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
            animation: fadeIn 1s ease 1.2s backwards;
        }

        .scroll-mouse {
            width: 26px;
            height: 42px;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 14px;
            position: relative;
            transition: border-color 0.3s;
        }

        .scroll-indicator:hover .scroll-mouse {
            border-color: rgba(251, 191, 36, 0.5);
        }

        .scroll-wheel {
            width: 3px;
            height: 8px;
            background: linear-gradient(180deg, #fbbf24, #ea580c);
            border-radius: 2px;
            position: absolute;
            top: 8px;
            left: 50%;
            transform: translateX(-50%);
            animation: scrollWheel 2s infinite;
        }

        @keyframes scrollWheel {
            0% { opacity: 1; transform: translateX(-50%) translateY(0); }
            100% { opacity: 0; transform: translateX(-50%) translateY(12px); }
        }

        .scroll-text {
            color: #52525b;
            font-size: 0.7rem;
            letter-spacing: 0.15em;
            font-weight: 500;
        }

        /* Animações de entrada */
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* Responsivo */
        @media (max-width: 768px) {
            .logo h1 { font-size: 3.5rem; }
            .logo h2 { font-size: 1.75rem; letter-spacing: 0.4em; }
            .logo-icon { font-size: 3rem; }
            .description { font-size: 1rem; padding: 0 1rem; }
            .cta-button { padding: 1rem 2.5rem; font-size: 1rem; }
            .features { gap: 1.5rem; }
            .feature-icon { width: 40px; height: 40px; }
            .circle-1, .circle-2, .circle-3 { display: none; }
            /* ✅ Esconder scroll indicator no mobile */
            .scroll-indicator { display: none !important; }
        }

        @media (max-width: 480px) {
            .logo h1 { font-size: 2.75rem; }
            .logo h2 { font-size: 1.25rem; letter-spacing: 0.3em; }
            .badge { padding: 0.5rem 1.25rem; }
            .badge span { font-size: 0.7rem; }
            .features { 
                flex-direction: column; 
                gap: 1.25rem;
                align-items: center; /* ✅ Centraliza horizontalmente */
            }
            .feature {
                width: 100%;
                max-width: 200px; /* ✅ Limita largura */
                justify-content: center; /* ✅ Centraliza conteúdo */
            }
            .cta-button { padding: 1rem 2rem; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Background Grid -->
        <div class="bg-grid"></div>
        
        <!-- Background Gradient -->
        <div class="bg-gradient"></div>
        
        <!-- Círculos decorativos -->
        <div class="bg-circles">
            <div class="circle circle-1"></div>
            <div class="circle circle-2"></div>
            <div class="circle circle-3"></div>
        </div>
        
        <!-- Partículas -->
        <div class="particles">
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
        </div>

        <!-- Conteúdo -->
        <div class="content">
            <!-- Badge -->
            <div class="badge">
                <div class="badge-dot"></div>
                <span>ABERTO AGORA</span>
            </div>

            <!-- Logo -->
            <div class="logo">
                <span class="logo-icon">🍔</span>
                <h1>BURGER</h1>
                <h2>HOUSE</h2>
            </div>
            
            <!-- Linha decorativa -->
            <div class="divider"></div>

            <!-- Descrição -->
            <p class="description">
                Hambúrgueres artesanais feitos com <strong>ingredientes premium</strong>.<br>
                Sabor incomparável em cada mordida.
            </p>

            <!-- Botão CTA -->
            <div class="cta-wrapper">
                <a href="/cardapio" class="cta-button">
                    Ver Cardápio
                    <i data-lucide="arrow-right"></i>
                </a>
            </div>

            <!-- Features -->
            <div class="features">
                <div class="feature">
                    <div class="feature-icon">
                        <i data-lucide="clock"></i>
                    </div>
                    <span>Entrega Rápida</span>
                </div>
                <div class="feature">
                    <div class="feature-icon">
                        <i data-lucide="star"></i>
                    </div>
                    <span>4.9 Avaliação</span>
                </div>
                <div class="feature">
                    <div class="feature-icon">
                        <i data-lucide="percent"></i>
                    </div>
                    <span>Sem Taxa</span>
                </div>
            </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="scroll-indicator">
            <div class="scroll-mouse">
                <div class="scroll-wheel"></div>
            </div>
            <span class="scroll-text">SCROLL</span>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>

    <!-- PWA Tags -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#050505">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Burger House">
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png">
    <script src="/js/pwa-install.js" defer></script>
</body>
</html>
